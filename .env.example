# ============================================================
# AI-Native Fullstack Workflow - Environment Configuration
# ============================================================
# Copy this file to .env and adjust the values.
#   cp .env.example .env
#
# Never commit the real .env file (it is gitignored).
# ============================================================

# --- Backend -------------------------------------------------
# Port the NestJS API listens on
PORT=3001

# Frontend origin allowed by the API CORS policy
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) -----------------------------------
# When DATABASE_URL is set, the backend connects to PostgreSQL.
# When it is empty, the API boots without persistence
# (useful for skeleton development and CI without a DB service).
#
# Docker Compose (recommended):
#   yarn db:up   -> starts postgres with the credentials below
#
# Local PostgreSQL without Docker:
#   sudo -u postgres psql
#     CREATE USER dev WITH PASSWORD 'dev_password';
#     CREATE DATABASE ai_workflow_dev OWNER dev;
DATABASE_URL=postgresql://dev:dev_password@localhost:5432/ai_workflow_dev
#
# Alternatively, leave DATABASE_URL unset and provide discrete
# variables; the backend derives DATABASE_URL from them:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=dev
# DB_PASSWORD=dev_password
# DB_DATABASE=ai_workflow_dev

# --- Frontend (server-side only) -----------------------------
# Base URL of the API, used by Next.js server components
API_BASE_URL=http://localhost:3001
